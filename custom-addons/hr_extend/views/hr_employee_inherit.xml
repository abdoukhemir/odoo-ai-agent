<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit Employee Form -->
    <record id="view_employee_form_inherit" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/> <!-- ✅ correct external ID -->
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group>
                    <field name="emergency_contact"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Inherit Employee List -->
    <record id="view_employee_list_inherit" model="ir.ui.view">
        <field name="name">hr.employee.list.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/> <!-- ✅ correct external ID -->
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="emergency_contact"/>
            </xpath>
        </field>
    </record>

    <!-- Override Employees Window Action to force list first -->
    <record id="hr.open_view_employee_list" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field> <!-- ✅ list first -->
        <field name="view_id" ref="hr.view_employee_tree"/> <!-- ✅ attach list view -->
    </record>
</odoo>
