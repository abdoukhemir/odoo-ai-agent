<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id='enrollment_Kanban_view' model='ir.ui.view'>
        <field name='name'>enrollment kanban view</field>
        <field name='model'>school.enrollment</field>
        <field name='arch' type='xml'>
            <kanban string="Enrollment Kanban" default_group_by="course_id">
                <templates>
                    <t t-name="card">

                        <div class="o_kanban_card">
                            <strong>
                                <field name="student_id" />
                            </strong>
                            <div> Course: <field name="course_id" />
                            </div>
                            <div> Grade: <field name="grade" />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>

        </field>
    </record>

     <record id='enrollment_calendar_view' model='ir.ui.view'>
        <field name='name'>enrollment calendar view</field>
        <field name='model'>school.enrollment</field>
        <field name='arch' type='xml'>
            <calendar date_start="enrollment_date" color="student_id" string="Enrollment Calendar">
                <field name="student_id" />
                <field name="course_id" />
                <field name="grade" />

            </calendar>
        </field>
    </record>

    <record id='enrollment_list_view' model='ir.ui.view'>
        <field name='name'>enrollment list view</field>
        <field name='model'>school.enrollment</field>
        <field name='arch' type='xml'>
            <list multi_edit="1" string="Enrollment List" class="custom_list_view">
                <field name="student_id" />
                <field name="course_id" />
                <field name="enrollment_date" />
                <field name="grade" />
                <field name="phone_number"/>
            </list>
        </field>
    </record>
    <record id='enrollment_form_view' model='ir.ui.view'>
        <field name='name'>enrollment form view</field>
        <field name='model'>school.enrollment</field>
        <field name='arch' type='xml'>
            <form string="Enrollment Form">

                <group string="Enrollment Information">
                    <field name="student_id" />
                    <field name="course_id" />
                    <field name="enrollment_date" />
                    <field name="grade" />
                    <field name="phone_number"/>
                </group>

            </form>
        </field>
    </record>
    <record id='enrollment_search_view' model='ir.ui.view'>
        <field name='name'>enrollment search view</field>
        <field name='model'>school.enrollment</field>
        <field name='arch' type='xml'>
            <search string="Enrollment Search">

                <field name="student_id" />
                <field name="course_id" />
                <field name="enrollment_date" />
                <filter name="filter_by_student" string="By Student"
                    domain="[('student_id.name','ilike','%student%')]" />
                <filter name="filter_by_course" string="By Course"
                    domain="[('course_id.name','ilike','%course%')]" />
            </search>
        </field>
    </record>
    <record id='enrollment_action' model='ir.actions.act_window'>
        <field name='name'>Enrollment Action</field>
        <field name='res_model'>school.enrollment</field>
        <field name='view_mode'>list,form,kanban,calendar</field>
    </record>
    <menuitem id='enrollment_action_menu' name='Enrollments Management'
        parent='school_enrollment_sub_menu' action='enrollment_action' />
</odoo> 
  