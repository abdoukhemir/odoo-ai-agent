<odoo>

    <record id="view_ai_bot_access_form" model="ir.ui.view">
        <field name="name">ai.bot.access.form</field>
        <field name="model">ai.bot.access</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h2>AI Bot Model Permissions</h2>
                    
                    <group>
                        <field name="user_id" readonly="1" />
                        <field name="model_id" />
                    </group>

                    <group string="Permissions" colspan="2" col="4">
                        <field name="allow_read" />
                        <field name="allow_create" />
                        <field name="allow_write" />
                        <field name="allow_unlink" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ai_bot_access_list" model="ir.ui.view">
        <field name="name">ai.bot.access.list</field>
        <field name="model">ai.bot.access</field>
        <field name="arch" type="xml">
            <list>
                <field name="model_id" />
                <field name="allow_read" />
                <field name="allow_create" />
                <field name="allow_write" />
                <field name="allow_unlink" />
            </list>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_ai_bot_access" model="ir.actions.act_window">
        <field name="name">AI Bot Permissions</field>
        <field name="res_model">ai.bot.access</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- SETTINGS MENU -->
    <menuitem id="menu_ai_bot_access"
              name="AI Bot Permissions"
              parent="base.menu_administration"
              action="action_ai_bot_access"
              sequence="10"/>

</odoo>