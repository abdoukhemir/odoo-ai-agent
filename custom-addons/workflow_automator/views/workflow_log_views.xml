<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_workflow_log_form" model="ir.ui.view">
        <field name="name">workflow.log.form</field>
        <field name="model">workflow.log</field>
        <field name="arch" type="xml">
            <form string="Workflow Log">
                <sheet>
                    <group>
                        <field name="workflow_id"/>
                        <field name="execution_date"/>
                        <field name="status"/>
                        <field name="duration"/>
                        <field name="details"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_workflow_log_list" model="ir.ui.view">
        <field name="name">workflow.log.list</field>
        <field name="model">workflow.log</field>
        <field name="arch" type="xml">
            <list string="Workflow Logs">
                <field name="workflow_id"/>
                <field name="execution_date"/>
                <field name="status"/>
                <field name="duration"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_workflow_log" model="ir.actions.act_window">
        <field name="name">Workflow Logs</field>
        <field name="res_model">workflow.log</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>
