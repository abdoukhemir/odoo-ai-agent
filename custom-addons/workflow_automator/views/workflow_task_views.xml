<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_workflow_task_form" model="ir.ui.view">
        <field name="name">workflow.task.form</field>
        <field name="model">workflow.task</field>
        <field name="arch" type="xml">
            <form string="Workflow Task">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="action_type" />
                        <field name="sequence" />
                        <field name="workflow_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_workflow_task_list" model="ir.ui.view">
        <field name="name">workflow.task.list</field>
        <field name="model">workflow.task</field>
        <field name="arch" type="xml">
            <list string="Workflow Tasks">
                <field name="name" />
                <field name="action_type" />
                <field name="sequence" />
                <field name="workflow_id" />
            </list>
        </field>
    </record>




    
    <record id="action_workflow_task" model="ir.actions.act_window">
        <field name="name">Workflow Tasks</field>
        <field name="res_model">workflow.task</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>