<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <!-- Form View -->
    <record id="view_workflow_definition_form" model="ir.ui.view">
        <field name="name">workflow.definition.form</field>
        <field name="model">workflow.definition</field>
        <field name="arch" type="xml">
            <form string="Workflow Definition">
                <sheet>
                    <button name="run_workflow" type="object" string="Run Workflow" class="btn-primary" />
                    <field name="last_run_date" />
                    <field name="last_status" widget="statusbar" statusbar_visible="success,failure" />
                    <group>
                        <field name="name" />
                        <field name="trigger_type" />
                        <field name="active" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_workflow_definition_list" model="ir.ui.view">
        <field name="name">workflow.definition.list</field>
        <field name="model">workflow.definition</field>
        <field name="arch" type="xml">
            <list string="Workflow Definitions">
                <field name="name" />
                <field name="trigger_type" />
                <field name="active" />
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_workflow_definition" model="ir.actions.act_window">
        <field name="name">Workflow Definitions</field>
        <field name="res_model">workflow.definition</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>