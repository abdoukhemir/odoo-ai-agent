<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_sale_product_list" model="ir.ui.view">
        <field name="name">sale.custom.product.list</field>
        <field name="model">sale.custom.product</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="unit_price"/>
            </list>
        </field>
    </record>

    <record id="view_sale_product_form" model="ir.ui.view">
        <field name="name">sale.custom.product.form</field>
        <field name="model">sale.custom.product</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="unit_price"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sale_custom_product" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">sale.custom.product</field>
        <field name="view_mode">list,form</field>
    </record>

 
</odoo>
