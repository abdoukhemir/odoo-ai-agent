<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_sale_order_pivot" model="ir.ui.view">
        <field name="name">sale.custom.order.pivot</field>
        <field name="model">sale.custom.order</field>
        <field name="arch" type="xml">
            <pivot string="Sales Analysis">
                <field name="total_amount" type="measure"/>
                <field name="customer_id" type="row"/>
                <field name="salesperson_id" type="row"/>
                <field name="order_date" type="col" interval="month"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_sale_order_graph" model="ir.ui.view">
        <field name="name">sale.custom.order.graph</field>
        <field name="model">sale.custom.order</field>
        <field name="arch" type="xml">
            <graph string="Sales Graph" type="bar">
                <field name="total_amount" type="measure"/>
                <field name="salesperson_id" type="row"/>
                <field name="order_date" type="col" interval="month"/>
            </graph>
        </field>
    </record>


    <record id="action_sale_custom_reporting" model="ir.actions.act_window">
        <field name="name">Sales Reporting</field>
        <field name="res_model">sale.custom.order</field>
        <field name="view_mode">pivot,graph</field>
    </record>

 
</odoo>
